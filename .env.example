# All values are OPTIONAL — docker-compose has sensible defaults and runs without a .env,
# using the bundled `db` Postgres service. Copy to .env only to override.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True

# Database — defaults target the bundled `db` service (see docker-compose.yml).
POSTGRES_DB=taxi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db          # use the bundled Postgres. For an EXTERNAL db set the host here,
                          # e.g. 172.29.128.1 (a Windows-hosted Postgres reached from WSL).
POSTGRES_PORT=5432

# Timezone (NYC taxi data)
TZ=America/New_York

# Optional: auto-load data on container start (runs once — skipped if data exists).
# Leave unset for a fast startup with an empty DB; set to 1 to download+load.
#RUN_SETUP_DATA=1
# Limit what gets downloaded (the full dataset is tens of GB). Example:
# Dec 2016 is REQUIRED for the live-page prewarm (30 days before the 2017-01-01 demo start):
#SETUP_DATA_ARGS=--months-train 2016-12:2016-12 --months-test 2017-01:2017-01
